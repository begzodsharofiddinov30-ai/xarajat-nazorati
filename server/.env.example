# development | production (production'da server client/dist ni ham tarqatadi)
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/xarajat-nazorati
# Development: kamida 16 belgi, production: kamida 32 belgi. Generatsiya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Bir nechta manzil vergul bilan ajratiladi
CLIENT_URL=http://localhost:5173
# Proksi (Render, Railway, Nginx) orqasida: 1
TRUST_PROXY=0
